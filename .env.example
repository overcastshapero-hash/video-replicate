# video-replicate 环境变量配置
# 复制为 .env 后填写，.env 已被 .gitignore 忽略，不会提交
#
# 推荐做法：用这个 .env（只对本 skill 生效），而不是污染全局 zshrc

# ===================== 必填 =====================
# 小云雀 Access Key
# 从 https://xyq.jianying.com 登录后 → 用户中心 → 获取 Access Key
XYQ_ACCESS_KEY=ak-你的key

# ===================== 可选 =====================

# 小云雀 OpenAPI 地址（一般不需要改）
# XYQ_OPENAPI_BASE=https://xyq.jianying.com

# 轮询间隔（秒），默认 15
# XYQ_POLL_INTERVAL=15

# 最大轮询次数（默认 200 ≈ 50 分钟）
# XYQ_POLL_MAX_ITER=200

# ===================== 使用建议 =====================
# 1. 新用户建议先用 30 秒 demo 测试，消耗较少
# 2. 小云雀按生成次数扣 credits，一条 30s demo 通常消耗 25-40+ 额度
# 3. 遇到积分不足（11001）时，可充值后用同一个 thread_id 继续 resume
# 4. 本 .env 优先级高于 shell export，但低于 Claude Code 当前会话已设置的变量