# video-replicate 环境变量模板
# ─────────────────────────────────────────────────
# 1. 复制这个文件为 .env (不要提交,已在 .gitignore)
#    cp .env.example .env
# 2. 填入你自己的 key
# 3. 或者直接 export 到 shell:
#    echo 'export XYQ_ACCESS_KEY="ak-xxx"' >> ~/.zshrc && source ~/.zshrc
# ─────────────────────────────────────────────────

# 小云雀 Access Key — 必填
# 从 https://xyq.jianying.com 用户中心拿
XYQ_ACCESS_KEY=ak-填你自己的key这里

# 小云雀 OpenAPI 基址 — 可选(默认 https://xyq.jianying.com)
# XYQ_OPENAPI_BASE=https://xyq.jianying.com

# xyq_poll.sh 轮询间隔(秒)— 可选,默认 15
# XYQ_POLL_INTERVAL=15

# xyq_poll.sh 最大循环次数 — 可选,默认 200 (= 50 分钟 @ 15s)
# XYQ_POLL_MAX_ITER=200
